# PostgreSQL connection string. Migrations are applied automatically on boot.
DATABASE_URL=postgres://skyoj:skyoj@localhost:5432/skyoj

# RabbitMQ: buffers submissions and judge results so bursts do not hit
# PostgreSQL all at once.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# How many queued writes are applied to PostgreSQL at the same time.
# DB_WRITE_CONCURRENCY=8

# Where the API listens. Keep it on a private interface: only the web server
# and the judge machines need to reach it.
HOST=127.0.0.1
PORT=3001

# Testdata and problem attachments are stored here.
DATA_DIR=./data

# SESSION_TTL_DAYS=30
# Seconds before a submission stuck in "Judging" is handed to another judge.
# JUDGE_TIMEOUT_SEC=600
# MAX_UPLOAD_MB=256
