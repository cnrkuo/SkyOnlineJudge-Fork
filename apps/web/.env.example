# Base URL of the API (apps/api), as reachable from the web server.
API_URL=http://127.0.0.1:3001

# Signs the session cookie. Required in production; use a long random string.
SESSION_SECRET=change-me

# Port of the web server.
PORT=3000

# SITE_NAME=Sky Online Judge
# IANA time zone all times are shown and entered in.
# SITE_TIMEZONE=Asia/Taipei
# The session cookie is "Secure" in production; set to false only when
# serving over plain HTTP.
# COOKIE_SECURE=true
