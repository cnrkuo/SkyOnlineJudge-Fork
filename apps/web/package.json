{
  "name": "@skyoj/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "node --env-file-if-exists=.env ./node_modules/@react-router/dev/bin.cjs dev",
    "start": "node --env-file-if-exists=.env ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@orpc/client": "^1.16.2",
    "@orpc/contract": "^1.16.2",
    "@orpc/openapi-client": "^1.16.2",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@skyoj/contract": "workspace:*",
    "isbot": "^5.1.36",
    "katex": "^0.16.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
